@page
@model IndexModel
@{
    ViewData["Title"] = "Event photo wall";
}

<section class="hero-section">
    <div>
        <span class="badge rounded-pill text-bg-primary mb-3">Azure SMS photo sharing</span>
        <h1 class="display-5 fw-bold">Turn incoming event photos into a live montage.</h1>
        <p class="lead text-muted mb-4">
            Each photo and its message are stored together in Azure Blob Storage, keeping the app on the lowest-cost Azure storage service while still showing a live gallery.
        </p>
        <p class="text-muted small mb-0">
            SMS/MMS providers can send multipart form posts to <code>/api/messages</code> using <code>photo</code>, <code>message</code>, and <code>from</code> fields.
        </p>
    </div>

    <div class="upload-panel shadow-sm">
        <h2 class="h4 mb-3">Test a new submission</h2>
        <form method="post" enctype="multipart/form-data" class="d-grid gap-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="Input.Sender" class="form-label">Sender</label>
                <input asp-for="Input.Sender" class="form-control" maxlength="40" placeholder="+1 555 0100" />
            </div>
            <div>
                <label asp-for="Input.Message" class="form-label">Message</label>
                <textarea asp-for="Input.Message" class="form-control" rows="3" maxlength="280" placeholder="Having a great time at the event!"></textarea>
            </div>
            <div>
                <label asp-for="Input.Photo" class="form-label">Photo</label>
                <input asp-for="Input.Photo" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
            </div>
            <button type="submit" class="btn btn-primary">Add to photo wall</button>
        </form>
    </div>
</section>

<section class="mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0">Photo montage</h2>
        <span class="text-muted">@Model.Photos.Count photo(s)</span>
    </div>

    @if (Model.Photos.Count == 0)
    {
        <div class="empty-state">
            <p class="mb-1">No event photos have been received yet.</p>
            <p class="text-muted mb-0">Post an MMS-style submission above or call <code>/api/messages</code> to start the montage.</p>
        </div>
    }
    else
    {
        <div class="photo-grid">
            @foreach (var photo in Model.Photos)
            {
                <article class="photo-card shadow-sm">
                    <img src="/photos/@photo.Id" alt="@photo.Message" class="photo-card-image" loading="lazy" />
                    <div class="photo-card-body">
                        <p class="photo-card-message">@photo.Message</p>
                        <div class="photo-card-meta">
                            <span>@(photo.Sender ?? "Anonymous")</span>
                            <span>@photo.CreatedAt.ToLocalTime().ToString("g")</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
